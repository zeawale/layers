# Скопируй в .env и подставь свои значения. .env в git не попадает.

# --- Postgres ---
POSTGRES_USER=layers
POSTGRES_PASSWORD=change_me
POSTGRES_DB=layers
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Backend ---
# Ключ для подписи JWT. Сгенерировать: openssl rand -hex 32
SECRET_KEY=change_me
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Откуда разрешаем запросы (dev-сервер Vite)
CORS_ORIGINS=http://localhost:5173

# --- Frontend ---
VITE_API_URL=http://localhost:8000
