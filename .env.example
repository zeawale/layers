# Скопируй в .env и подставь свои значения. .env в git не попадает.

# --- Postgres ---
POSTGRES_USER=layers
POSTGRES_PASSWORD=change_me
POSTGRES_DB=layers
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Backend ---
# Ключ для подписи JWT. Сгенерировать: openssl rand -hex 32
SECRET_KEY=change_me
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Откуда разрешаем запросы (dev-сервер Vite)
CORS_ORIGINS=http://localhost:5173
# Адрес фронта: из него собирается ссылка в письме сброса пароля
FRONTEND_URL=http://localhost:5173

# --- Почта (письма сброса пароля) ---
# Можно оставить пустым: тогда письма не отправляются, а печатаются в лог
# бэкенда — смотреть через docker compose logs backend.
# Для Яндекса: SMTP_HOST=smtp.yandex.ru, пароль — «пароль приложения»,
# MAIL_FROM совпадает с SMTP_USER.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# --- Frontend ---
VITE_API_URL=http://localhost:8000
